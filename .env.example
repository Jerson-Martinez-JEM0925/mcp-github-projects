# ── MCP Environment Configuration ────────────────────────────────────────────
#
# Copy this file and fill in your values:
#   cp .env.example .env
#
# Documentation:
#   Token generation:    docs/SETUP.md#token-generation
#   Token rotation:      docs/SETUP.md#token-rotation
#   Target config:       docs/SETUP.md#target-configuration
#   Full reference:      docs/PARAMETERS.md
#
# ⚠️  NEVER commit .env — it contains credentials and is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ───────────────────────────────────────────────────────────
#
# Generate a Personal Access Token:
#   Classic:       https://github.com/settings/tokens/new
#   Fine-grained:  https://github.com/settings/personal-access-tokens/new
#
# Required scopes (Classic PAT):
#   repo, project, read:org
#
# Required permissions (Fine-grained PAT):
#   Issues: Read & Write
#   Projects: Read & Write
#   Organization → Projects: Read & Write
#   Organization → Members: Read
#
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Target ───────────────────────────────────────────────────────────────────
#
# The GitHub Project V2 board to manage.
#
# For organization projects:
#   https://github.com/orgs/{ORG}/projects/{NUMBER}
#
# For user projects:
#   https://github.com/users/{USERNAME}/projects/{NUMBER}
#

# GitHub owner — organization login or username
GH_PROJECT_ORG_NAME=my-org

# Repository name within the owner
GH_PROJECT_REPO_NAME=my-repo

# Project V2 board number (visible in the project URL)
GH_PROJECT_PROJECT_NUMBER=1

# Owner type: 'organization' for org projects, 'user' for personal projects
GH_PROJECT_OWNER_TYPE=organization

# ── Access level ─────────────────────────────────────────────────────────────
#
# MCP_ACCESS_LEVEL controls WHICH TOOLS the server exposes. Tools hidden at a
# level are not registered — the client cannot see or call them.
#
#   read   — only read-only tools are exposed.
#   write  — DEFAULT. Today's surface: create / update / close / archive.
#            No permanent-delete tools.
#   full   — everything, INCLUDING permanent-delete tools. Each delete tool
#            additionally requires confirm:true or it refuses.
#
# NOTE: this variable is MCP_-prefixed (NOT GH_PROJECT_), matching the
# write-policy variables in mcp-monday-projects.
#
MCP_ACCESS_LEVEL=write

# ── Scope lock ───────────────────────────────────────────────────────────────
#
# GH_PROJECT_SCOPE_LOCK confines EVERY tool to the configured
# GH_PROJECT_ORG_NAME / GH_PROJECT_REPO_NAME / GH_PROJECT_PROJECT_NUMBER above.
# When true, a tool that is asked to target any other owner/repo/project is
# refused with a typed error naming this variable, before any mutation runs.
# (Parity concept with mcp-monday-projects' MONDAY_WORKSPACE_ID.)
#
#   false  — DEFAULT. The server is as wide as the token allows.
#   true   — every call is fenced to the configured target.
#
GH_PROJECT_SCOPE_LOCK=false

# ── Access level examples ────────────────────────────────────────────────────
#
# Copy-paste one of the presets below over the two lines above.
#
#   # Read-only (analyst / reporting): expose nothing that mutates.
#   MCP_ACCESS_LEVEL=read
#   GH_PROJECT_SCOPE_LOCK=true
#
#   # Write (default day-to-day automation): create/update/close/archive,
#   # no permanent deletes; fenced to one board.
#   MCP_ACCESS_LEVEL=write
#   GH_PROJECT_SCOPE_LOCK=true
#
#   # Full control (maintenance): also expose permanent-delete tools
#   # (each still requires confirm:true).
#   MCP_ACCESS_LEVEL=full
#   GH_PROJECT_SCOPE_LOCK=false

# ── Optional ─────────────────────────────────────────────────────────────────
#
# Uncomment and adjust if the defaults don't fit your environment.
# See docs/PARAMETERS.md for full details and valid ranges.
#

# Maximum seconds to wait for a single GitHub API call (range: 1–120)
# GH_PROJECT_TIMEOUT_SECONDS=10

# Number of automatic retries on read failures (range: 0–5, mutations never retry)
# GH_PROJECT_RETRY_ATTEMPTS=1

# Hours before cached project metadata expires and re-fetches (range: 1–720)
# GH_PROJECT_CACHE_TTL_HOURS=24

# Maximum items returned per list/query operation (range: 1–1000)
# GH_PROJECT_MAX_ITEMS=200
