# ── MCP Environment Configuration ────────────────────────────────────────────
#
# Copy this file and fill in your values:
#   cp .env.example .env
#
# Documentation:
#   Token generation:    docs/SETUP.md#token-generation
#   Token rotation:      docs/SETUP.md#token-rotation
#   Target config:       docs/SETUP.md#target-configuration
#   Full reference:      docs/PARAMETERS.md
#
# ⚠️  NEVER commit .env — it contains credentials and is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ───────────────────────────────────────────────────────────
#
# Generate a Personal Access Token:
#   Classic:       https://github.com/settings/tokens/new
#   Fine-grained:  https://github.com/settings/personal-access-tokens/new
#
# Required scopes (Classic PAT):
#   repo, project, read:org
#
# Required permissions (Fine-grained PAT):
#   Issues: Read & Write
#   Projects: Read & Write
#   Organization → Projects: Read & Write
#   Organization → Members: Read
#
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Target ───────────────────────────────────────────────────────────────────
#
# The GitHub Project V2 board to manage.
#
# For organization projects:
#   https://github.com/orgs/{ORG}/projects/{NUMBER}
#
# For user projects:
#   https://github.com/users/{USERNAME}/projects/{NUMBER}
#

# GitHub owner — organization login or username
GH_PROJECT_ORG_NAME=my-org

# Repository name within the owner
GH_PROJECT_REPO_NAME=my-repo

# Project V2 board number (visible in the project URL)
GH_PROJECT_PROJECT_NUMBER=1
# Optional comma-separated additional Project V2 boards for project tools.
# GH_PROJECT_PROJECT_NUMBERS=1,2

# Owner type: 'organization' for org projects, 'user' for personal projects
GH_PROJECT_OWNER_TYPE=organization

# ── Access level ─────────────────────────────────────────────────────────────
#
# MCP_ACCESS_LEVEL controls WHICH TOOLS the server exposes. Tools hidden at a
# level are not registered — the client cannot see or call them.
#
#   read   — only read-only tools are exposed.
#   write  — DEFAULT. Today's surface: create / update / close / archive.
#            No permanent-delete tools.
#   full   — everything, INCLUDING permanent-delete tools. Each delete tool
#            additionally requires confirm:true or it refuses.
#
# NOTE: this variable is MCP_-prefixed (NOT GH_PROJECT_), matching the
# write-policy variables in mcp-monday-projects.
#
MCP_ACCESS_LEVEL=write

# Role-based catalog profile. It narrows the visible tools by capability but
# never grants more than MCP_ACCESS_LEVEL allows.
#   full            — DEFAULT. every tool allowed by the access level
#   developer       — issues, PRs, repository content, board updates, checks read
#   devops          — developer surface plus workflow dispatch/rerun/merge control
#   project_manager — Projects V2, milestones, labels, planning and issue writes
#   read_only       — read-only catalog across repository, PRs, actions and projects
#   commenter       — issue reading plus comment writing
# MCP_TOOL_PROFILE=full

# Optional: expose only these write/delete tools (read tools are unaffected).
# MCP_WRITE_TOOL_ALLOWLIST=create_branch,commit_files,create_pull_request
# Governed commits: branch prefixes create_branch/commit_files may write to
# (the default branch is always refused) and path prefixes commit_files may
# touch (.github/ is always refused; empty = any other path).
# GH_PROJECT_WRITE_BRANCH_PREFIXES=chatbot/
# GH_PROJECT_WRITE_PATH_PREFIXES=docs/
# Optional: replace the built-in model instructions sent on initialize.
# MCP_SERVER_INSTRUCTIONS=
# Structured operations logs: text or json; DEBUG enables per-tool latency logs
# MCP_LOG_LEVEL=WARNING
# MCP_LOG_FORMAT=text
# Optional OpenTelemetry spans for tool invocations (metadata only, no arguments/secrets)
# MCP_OTEL_ENABLED=false
# MCP_OTEL_SERVICE_NAME=github-project-mcp
# MCP_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── Scope lock ───────────────────────────────────────────────────────────────
#
# GH_PROJECT_SCOPE_LOCK confines EVERY tool to the configured
# GH_PROJECT_ORG_NAME / GH_PROJECT_REPO_NAME / GH_PROJECT_PROJECT_NUMBER above.
# When true, a tool that is asked to target any other owner/repo/project is
# refused with a typed error naming this variable, before any mutation runs.
# (Parity concept with mcp-monday-projects' MONDAY_WORKSPACE_ID.)
#
#   false  — DEFAULT. The server is as wide as the token allows.
#   true   — every call is fenced to the configured target.
#
GH_PROJECT_SCOPE_LOCK=false

# ── Assignee suggestions (optional) ──────────────────────────────────────────
# suggest_issue_assignee classifies an issue as backend or frontend by keywords
# and suggests the login configured here. Empty = report the area only.
# GH_PROJECT_BACKEND_ASSIGNEE=octocat
# GH_PROJECT_FRONTEND_ASSIGNEE=hubot

# ── Access level examples ────────────────────────────────────────────────────
#
# Copy-paste one of the presets below over the two lines above.
#
#   # Read-only (analyst / reporting): expose nothing that mutates.
#   MCP_ACCESS_LEVEL=read
#   GH_PROJECT_SCOPE_LOCK=true
#
#   # Write (default day-to-day automation): create/update/close/archive,
#   # no permanent deletes; fenced to one board.
#   MCP_ACCESS_LEVEL=write
#   GH_PROJECT_SCOPE_LOCK=true
#
#   # Full control (maintenance): also expose permanent-delete tools
#   # (each still requires confirm:true).
#   MCP_ACCESS_LEVEL=full
#   GH_PROJECT_SCOPE_LOCK=false

# ── Optional ─────────────────────────────────────────────────────────────────
#
# Uncomment and adjust if the defaults don't fit your environment.
# See docs/PARAMETERS.md for full details and valid ranges.
#

# Validate env credentials before stdio startup (true recommended)
# GH_PROJECT_VALIDATE_AUTH_ON_STARTUP=true

# Maximum seconds to wait for a single GitHub API call (range: 1–120, default 30)
# GH_PROJECT_TIMEOUT_SECONDS=30

# Number of automatic retries on read failures (range: 0–5, mutations never retry)
# GH_PROJECT_RETRY_ATTEMPTS=1

# Lightweight circuit breaker for consecutive transient GitHub API failures
# GH_PROJECT_CIRCUIT_BREAKER_FAILURES=5
# GH_PROJECT_CIRCUIT_BREAKER_RESET_SECONDS=30

# Hours before cached project metadata expires and re-fetches (range: 1–720)
# GH_PROJECT_CACHE_TTL_HOURS=24

# Maximum items returned per list/query operation (range: 1–1000)
# GH_PROJECT_MAX_ITEMS=200

# Maximum concurrent GitHub operations inside bulk/update tools (range: 1–20)
# GH_PROJECT_MAX_CONCURRENT_REQUESTS=5

# TTL for stable labels/milestones/workflow metadata in seconds (0 disables)
# GH_PROJECT_RESOURCE_CACHE_TTL_SECONDS=300

# Streamable HTTP hardening (only relevant with MCP_TRANSPORT=streamable-http)
# MCP_HTTP_MAX_BODY_BYTES=1000000
# MCP_HTTP_RATE_LIMIT_PER_MINUTE=240
# Validate request bearer tokens against GitHub before exposing MCP metadata
# MCP_HTTP_VALIDATE_TOKENS=true
# MCP_HTTP_AUTH_CACHE_TTL_SECONDS=60
# Require HTTPS/X-Forwarded-Proto=https for non-loopback remote HTTP requests
# MCP_HTTP_REQUIRE_TLS=false
