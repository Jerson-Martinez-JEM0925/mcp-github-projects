# ── Example Organization Profile ─────────────────────────────────────────────
# Copy this file as .env in the MCP root to target an example organization project board.
#
# Usage:
#   cp profiles/example-org.env .env

GH_PROJECT_ORG_NAME=my-org
GH_PROJECT_REPO_NAME=my-repo
GH_PROJECT_PROJECT_NUMBER=1
GH_PROJECT_OWNER_TYPE=organization
